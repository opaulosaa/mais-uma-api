{
  "info": {
    "name": "Mais Uma API - Testes",
    "description": "Coleção para testar endpoints de cadastro, login e conhecimentos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Cadastrar pessoa",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Teste\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"Senha123!\",\n  \"telefone\": \"123456\",\n  \"descricao\": \"usuario de teste\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/pessoas",
          "host": ["{{base_url}}"],
          "path": ["pessoas"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if(!pm.variables.get('email')){ pm.variables.set('email', 'test' + Date.now() + '@example.com'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function(){ pm.response.to.have.status(201); });",
              "try{ var body = pm.response.json(); pm.collectionVariables.set('user_id', body.id); }catch(e){}"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"Senha123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function(){ pm.response.to.have.status(200); });",
              "try{ var b = pm.response.json(); if(b.token) { pm.collectionVariables.set('token', b.token); pm.environment.set('token', b.token); } }catch(e){}"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar conhecimentos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/conhecimentos",
          "host": ["{{base_url}}"],
          "path": ["conhecimentos"]
        }
      }
    },
    {
      "name": "Criar conhecimento (autenticado)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Teste Postman\",\n  \"descricao\": \"descrição teste\",\n  \"categoria\": \"Geral\",\n  \"nivel\": \"BASICO\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/conhecimentos",
          "host": ["{{base_url}}"],
          "path": ["conhecimentos"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function(){ pm.response.to.have.status(201); });",
              "try{ var body = pm.response.json(); pm.collectionVariables.set('conhecimento_id', body.id); }catch(e){}"
            ]
          }
        }
      ]
    },
    {
      "name": "Excluir conhecimento (autenticado)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/conhecimentos/{{conhecimento_id}}",
          "host": ["{{base_url}}"],
          "path": ["conhecimentos", "{{conhecimento_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 204', function(){ pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    }
  ]
}
